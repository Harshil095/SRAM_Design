*** SUBCIRCUIT SRAM__sense_amplifier FROM CELL SRAM:sense_amplifier{sch}
.SUBCKT SRAM__sense_amplifier BL BLB gnd SAE SO SOB vdd
** GLOBAL gnd
** GLOBAL vdd
Mnmos@0 net@9 BL net@3 gnd CMOSN L=0.4U W=0.8U
Mnmos@1 net@3 BLB SO gnd CMOSN L=0.4U W=0.8U
Mnmos@2 net@3 SAE gnd gnd CMOSN L=0.4U W=1.6U
Mpmos@0 net@9 net@9 vdd vdd CMOSP L=0.4U W=3.2U
Mpmos@1 vdd net@9 SO vdd CMOSP L=0.4U W=3.2U
Xinverter@1 SO SOB SRAM__inverter

* Spice Code nodes in cell cell 'SRAM:sense_amplifier{sch}'
.include ./tsmc018.lib
.param VDD = 1.8
VDD1 vdd 0 DC 1.8
* Small load capacitors
Cso  SO  0 10f
Csob SOB 0 10f
* Drive SAE directly:
VSAE SAE 0 PWL(
+ 0n  0
+ 10n 0
+ 12n 1.8
+ 35n 1.8
+ 38n 0
+ 50n 0
+ 52n 1.8
+ 75n 1.8
+ 78n 0
+ 80n 0)
* Bitline inputs: Read 0 (BL dips), Read 1 (BLB dips)
VBL BL 0 PWL(
+ 0n  1.8
+ 10n 1.8
+ 15n 1.65
+ 35n 1.65
+ 40n 1.8
+ 50n 1.8
+ 55n 1.8
+ 75n 1.8
+ 80n 1.8)
VBLB BLB 0 PWL(
+ 0n  1.8
+ 10n 1.8
+ 15n 1.8
+ 35n 1.8
+ 40n 1.8
+ 50n 1.8
+ 55n 1.65
+ 75n 1.65
+ 80n 1.8)
.tran 0.1n 80n
.ENDS SRAM__sense_amplifier

*** SUBCIRCUIT SRAM__write_driver FROM CELL SRAM:write_driver{sch}
.SUBCKT SRAM__write_driver BL BLB gnd vdd WD WE
** GLOBAL gnd
** GLOBAL vdd
Mnmos@0 BL WE net@0 gnd CMOSN L=0.4U W=2.4U
Mnmos@1 BLB WE net@1 gnd CMOSN L=0.4U W=2.4U
Mnmos@2 net@1 net@3 gnd gnd CMOSN L=0.4U W=2.4U
Mnmos@3 gnd WD net@0 gnd CMOSN L=0.4U W=2.4U
Mnmos@4 net@3 WD gnd gnd CMOSN L=0.4U W=0.8U
Mpmos@0 vdd WD net@3 vdd CMOSP L=0.4U W=1.6U

* Spice Code nodes in cell cell 'SRAM:write_driver{sch}'
.include ./tsmc018.lib
.param VDD = 1.8
VDD1 vdd 0 DC 1.8
* Bitline column loading and precharge pull-ups to 1.8V
Cbl  BL   0 200f
Cblb BLB 0 200f
Rpu1 BL   vdd 50k
Rpu2 BLB vdd 50k
* Initial condition
.ic V(BL)=1.8 V(BLB)=1.8
* Write Enable pulses high during writes
VWE WE 0 PWL(
+ 0n   0
+ 10n  0
+ 12n  1.8
+ 30n  1.8
+ 32n  0
+ 50n  0
+ 52n  1.8
+ 70n  1.8
+ 72n  0
+ 80n  0)
* Write Data (first 0, then 1)
VWD WD 0 PWL(
+ 0n   0
+ 10n  0
+ 50n  0
+ 51n  1.8
+ 80n  1.8)
.tran 0.1n 80n
.ENDS SRAM__write_driver

